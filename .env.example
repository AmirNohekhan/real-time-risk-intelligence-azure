RISK_ENVIRONMENT=local
RISK_MODEL_PATH=artifacts/model_bundle.joblib
RISK_DATA_DIR=data
RISK_REVIEW_THRESHOLD=0.45
RISK_BLOCK_THRESHOLD=0.65
RISK_FALSE_NEGATIVE_COST=20
RISK_FALSE_POSITIVE_COST=1
# Azure authentication uses DefaultAzureCredential; never place credentials here.
RISK_EVENT_HUB_NAMESPACE=
RISK_EVENT_HUB_NAME=events
RISK_SERVICE_BUS_NAMESPACE=
RISK_SERVICE_BUS_QUEUE=investigation-cases
RISK_STORAGE_ACCOUNT=
RISK_STORAGE_CONTAINER=risk-data
APPLICATIONINSIGHTS_CONNECTION_STRING=
